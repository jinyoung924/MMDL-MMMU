# 모델 가중치 (LoRA 어댑터·병합 체크포인트, 26GB). pilot_forgetting/train_sft.py로 다시 만듭니다
pilot_forgetting/runs/*/step*/
# 인코더 탐침 입력 데이터 (831MB). python encoder_probe/probe.py data 로 다시 만듭니다
encoder_probe/data/
# 실행 로그. 결과는 각 폴더의 scores.json과 문서에 있습니다
*.log
# 초기 임시 분석. reports/와 failure_diagnosis/로 대체됐습니다
analysis/
# 수업 과제 안내문
assignment_guidance.md
Submission_template.md
__pycache__/
# GRPO 라운드별 생성 결과·어댑터·병합 체크포인트 (48GB). grpo/chain_v*.sh로 다시 만듭니다
grpo/runs/
# 다시 만들 수 있는 풀과 판정 모델 검증 원본. grpo/README.md "레포에 없는 것" 참고
grpo/data/pool.jsonl
grpo/data/pool_v3*
grpo/data/pool_v6_all.jsonl
grpo/data/screen_ids_v*.txt
grpo/judge_validation_*
# 216문항 진단의 응답 전문 (점수는 scores.json에 있음)
runs/*_216/*/predictions.jsonl
# StructReward 재현용 외부 데이터(VisualPRM400K-v1.1, 92GB)와 학습 산출물. structreward/protocol.md 참고
structreward/data/*
!structreward/data/build_summary.json
!structreward/data/heldout_ids.txt
!structreward/data/probe_ids.txt
structreward/runs/
# LoRA 어댑터·가중치는 어디에 있든 올리지 않습니다
*.safetensors
# 악보 판독 SFT의 합성 문항·실행 산출물·사례 이미지 (300MB). music/reading.py, music/chain*.sh, music/step0.py로 다시 만듭니다
music/data/
music/runs/
music/rerender/
music/step0/cases/
# 다음 후보 태깅 사례와 화학 구조식 문항 (58MB). targets/tag.py, targets/chem.py로 다시 만듭니다
targets/chem/
targets/diagrams/
# 실행 출력
*.out
# 11/09 이후 실행의 MMMU 응답 전문 (약 300MB). 점수는 scores.json, base와의 비교는 compare_*.txt에 있습니다
runs/**/predictions.jsonl
# 다시 만들 수 있는 풀 (prepare_vwi_mc.py, rft.py, v11_pilot.py)
grpo/data/pool_v7.jsonl
grpo/data/pool_v9_ref.jsonl
grpo/data/pool_v11_*.jsonl
